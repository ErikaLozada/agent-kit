#!/usr/bin/env python3
"""Hardened, zero-dependency HTTP server for harness-agnostic HTML briefs.

Serves .html files from ~/agent-briefs/ and ~/agent-briefs/archive/ with a
touch-friendly light-mode index page supporting Archive, Restore, and Delete.
Binds strictly to localhost (127.0.0.1) so remote access is handled privately
by Tailscale Serve over HTTPS.
"""

from __future__ import annotations

import argparse
import datetime as dt
import errno
import html
import json
import os
import re
import stat
import sys
import threading
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import quote, unquote, urlparse

CONFIG_PATH = Path(
    os.environ.get("AGENT_BRIEFS_CONFIG", Path.home() / ".config" / "agent-briefs" / "config")
).expanduser()
BRIEFS_DIR = Path(os.environ.get("AGENT_BRIEFS_DIR", Path.home() / "agent-briefs")).expanduser().resolve()
ARCHIVE_DIR = (BRIEFS_DIR / "archive").resolve()

TITLE_RE = re.compile(r"<title[^>]*>(.*?)</title>", re.IGNORECASE | re.DOTALL)
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*\.html$")
MAX_BRIEF_BYTES = 10 * 1024 * 1024  # 10 MB per brief
SOCKET_TIMEOUT_SEC = 15.0
MAX_CONCURRENT_REQUESTS = 16

BRIEF_CSP = (
    "default-src 'none'; "
    "script-src 'unsafe-inline'; "
    "style-src 'unsafe-inline'; "
    "img-src data:; "
    "font-src data:; "
    "connect-src 'none'; "
    "form-action 'none'; "
    "base-uri 'none'; "
    "frame-ancestors 'none'"
)

INDEX_CSP = (
    "default-src 'none'; "
    "script-src 'unsafe-inline'; "
    "style-src 'unsafe-inline'; "
    "connect-src 'self'; "
    "form-action 'none'; "
    "base-uri 'none'; "
    "frame-ancestors 'none'"
)

_CONCURRENCY_SEM = threading.Semaphore(MAX_CONCURRENT_REQUESTS)


def load_config_file(path: Path = CONFIG_PATH) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return values
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        val = val.strip().strip('"').strip("'")
        values[key.strip()] = val
    return values


def build_allowlists(local_port: int) -> tuple[set[str], set[str], str]:
    cfg = load_config_file()
    hosts = {f"127.0.0.1:{local_port}", f"localhost:{local_port}"}
    origins = {f"http://127.0.0.1:{local_port}", f"http://localhost:{local_port}"}

    base_url = os.environ.get("AGENT_BRIEFS_URL", cfg.get("BASE_URL", "")).strip().rstrip("/")
    if base_url:
        parsed = urlparse(base_url)
        if parsed.scheme in ("http", "https") and parsed.netloc:
            hosts.add(parsed.netloc.lower())
            origins.add(f"{parsed.scheme.lower()}://{parsed.netloc.lower()}")

    extra_hosts = os.environ.get("AGENT_BRIEFS_ALLOWED_HOSTS", cfg.get("ALLOWED_HOSTS", ""))
    for item in extra_hosts.split(","):
        cleaned = item.strip().lower()
        if cleaned:
            hosts.add(cleaned)

    extra_origins = os.environ.get("AGENT_BRIEFS_ALLOWED_ORIGINS", cfg.get("ALLOWED_ORIGINS", ""))
    for item in extra_origins.split(","):
        cleaned = item.strip().lower().rstrip("/")
        if cleaned:
            origins.add(cleaned)

    allowed_user = os.environ.get("AGENT_BRIEFS_ALLOWED_USER", cfg.get("ALLOWED_USER", "")).strip().lower()
    return hosts, origins, allowed_user


def ensure_dirs() -> None:
    BRIEFS_DIR.mkdir(parents=True, exist_ok=True)
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)


def is_safe_filename(name: str) -> bool:
    if not name or "/" in name or "\\" in name or ".." in name or "\n" in name or "\r" in name:
        return False
    return bool(SAFE_NAME_RE.fullmatch(name))


def resolve_brief(name: str, scope: str = "active") -> Path | None:
    if not is_safe_filename(name):
        return None
    base = ARCHIVE_DIR if scope == "archive" else BRIEFS_DIR
    candidate = base / name
    if candidate.is_symlink():
        return None
    if candidate.parent.resolve() != base:
        return None
    return candidate


def open_regular_nofollow(path: Path) -> tuple[int, os.stat_result] | None:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(path), flags)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            os.close(fd)
            return None
        return fd, st
    except OSError:
        os.close(fd)
        return None


def extract_title(path: Path) -> str:
    opened = open_regular_nofollow(path)
    if opened is not None:
        fd, _ = opened
        try:
            with os.fdopen(fd, "rb") as fh:
                head = fh.read(8192).decode("utf-8", errors="ignore")
            match = TITLE_RE.search(head)
            if match:
                cleaned = re.sub(r"\s+", " ", html.unescape(match.group(1))).strip()
                if cleaned:
                    return cleaned
        except OSError:
            pass
    stem = path.stem
    stem = re.sub(r"^\d{4}-\d{2}-\d{2}[-_]", "", stem)
    return stem.replace("-", " ").replace("_", " ").strip().title() or path.name


def format_size(num_bytes: int) -> str:
    if num_bytes < 1024:
        return f"{num_bytes} B"
    if num_bytes < 1024 * 1024:
        return f"{num_bytes / 1024:.1f} KB"
    return f"{num_bytes / (1024 * 1024):.1f} MB"


def list_scope(scope: str) -> list[dict]:
    base = ARCHIVE_DIR if scope == "archive" else BRIEFS_DIR
    ensure_dirs()
    items = []
    for entry in base.iterdir():
        if entry.is_symlink() or not is_safe_filename(entry.name):
            continue
        try:
            st = entry.lstat()
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode):
            continue
        mtime = dt.datetime.fromtimestamp(st.st_mtime)
        url_prefix = "/archive/" if scope == "archive" else "/"
        items.append(
            {
                "file": entry.name,
                "title": extract_title(entry),
                "size": st.st_size,
                "size_human": format_size(st.st_size),
                "mtime": st.st_mtime,
                "mtime_human": mtime.strftime("%Y-%m-%d %H:%M"),
                "url": f"{url_prefix}{quote(entry.name)}",
                "scope": scope,
            }
        )
    items.sort(key=lambda item: item["mtime"], reverse=True)
    return items


def safe_move_no_overwrite(src: Path, dst: Path) -> str:
    """Move src -> dst without following symlinks and without overwriting dst."""
    if src.is_symlink() or not src.exists():
        return "not_found"
    if dst.is_symlink() or dst.exists():
        return "exists"
    try:
        os.link(str(src), str(dst), follow_symlinks=False)
    except FileExistsError:
        return "exists"
    except FileNotFoundError:
        return "not_found"
    except OSError as exc:
        if exc.errno == errno.EEXIST:
            return "exists"
        raise
    try:
        os.unlink(str(src))
    except OSError:
        try:
            os.unlink(str(dst))
        except OSError:
            pass
        raise
    return "ok"


