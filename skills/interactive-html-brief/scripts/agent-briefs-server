BRIEF_CHROME_SCRIPT = r"""<script data-agent-brief-chrome-js>
(() => {
  const btn = document.getElementById("abChromeThemeBtn");
  const mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  let manual = false;
  function sysTheme() { return mq && mq.matches ? "dark" : "light"; }
  function eff() {
    const ex = document.documentElement.getAttribute("data-theme");
    return ex === "dark" || ex === "light" ? ex : sysTheme();
  }
  function sync() { if (btn) btn.textContent = eff() === "dark" ? "Light" : "Dark"; }
  function apply(t, persist) {
    document.documentElement.setAttribute("data-theme", t);
    sync();
    if (persist) {
      manual = true;
      try { localStorage.setItem("agent-briefs-theme", t); } catch (e) {}
    }
  }
  try {
    const saved = localStorage.getItem("agent-briefs-theme");
    if (saved === "dark" || saved === "light") {
      manual = true;
      apply(saved, false);
    } else {
      apply(sysTheme(), false);
    }
  } catch (e) { apply(sysTheme(), false); }
  if (mq) {
    const onSys = () => { if (!manual) apply(sysTheme(), false); };
    if (mq.addEventListener) mq.addEventListener("change", onSys);
    else if (mq.addListener) mq.addListener(onSys);
  }
  if (btn) btn.addEventListener("click", () => apply(eff() === "dark" ? "light" : "dark", true));
})();
</script>"""


def inject_brief_chrome(data: bytes, title: str) -> bytes:
    """Ensure every served brief has a back-to-index link and Dark/Light auto+manual theme toggle."""
    try:
        doc = data.decode("utf-8")
    except UnicodeDecodeError:
        return data
    if 'data-brief-chrome="1"' in doc or 'data-agent-brief-chrome-css' in doc:
        return data

    has_native_dark = (
        'data-theme="dark"' in doc
        or "prefers-color-scheme: dark" in doc
        or "prefers-color-scheme:dark" in doc
    )
    head_inject = BRIEF_CHROME_CSS + ("" if has_native_dark else "\n" + BRIEF_LEGACY_DARK_CSS)
    safe_title = html.escape(title or "Brief")
    bar_html = (
        '<div class="ab-chrome" data-brief-chrome="1">'
        '<a class="ab-chrome-back" href="/">← All Briefs</a>'
        '<span class="ab-chrome-mark" aria-hidden="true"></span>'
        f'<span class="ab-chrome-title">{safe_title}</span>'
        '<button type="button" class="ab-chrome-btn" id="abChromeThemeBtn">Dark</button>'
        "</div>"
    )

    if "</head>" in doc.lower():
        doc = re.sub(r"</head>", lambda _: head_inject + "\n</head>", doc, count=1, flags=re.IGNORECASE)
    else:
        doc = head_inject + "\n" + doc

    if re.search(r"<body[^>]*>", doc, flags=re.IGNORECASE):
        doc = re.sub(r"(<body[^>]*>)", lambda m: m.group(1) + "\n" + bar_html, doc, count=1, flags=re.IGNORECASE)
    else:
        doc = bar_html + "\n" + doc

    if "</body>" in doc.lower():
        doc = re.sub(r"</body>", lambda _: BRIEF_CHROME_SCRIPT + "\n</body>", doc, count=1, flags=re.IGNORECASE)
    else:
        doc = doc + "\n" + BRIEF_CHROME_SCRIPT

    return doc.encode("utf-8")


class BoundedThreadingHTTPServer(ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 16


class BriefsHandler(BaseHTTPRequestHandler):
    def setup(self) -> None:
        super().setup()
        self.connection.settimeout(SOCKET_TIMEOUT_SEC)

    def log_message(self, format: str, *args) -> None:  # noqa: A002
        sys.stderr.write(f"[agent-briefs] {self.address_string()} - {format % args}\n")

    def _send_bytes(
        self,
        status: int,
        content_type: str,
        body: bytes,
        csp: str | None = None,
    ) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        if csp:
            self.send_header("Content-Security-Policy", csp)
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, status: int, payload: dict) -> None:
        raw = json.dumps(payload).encode("utf-8")
        self._send_bytes(status, "application/json; charset=utf-8", raw)

    def _check_host_and_user(self) -> bool:
        local_port = self.server.server_address[1]
        allowed_hosts, _, allowed_user = build_allowlists(local_port)
        host = (self.headers.get("Host") or "").strip().lower()
        if host not in allowed_hosts:
            self._send_bytes(HTTPStatus.MISDIRECTED_REQUEST, "text/plain; charset=utf-8", b"Disallowed Host header\n")
            return False
        if allowed_user:
            ts_user = (self.headers.get("Tailscale-User-Login") or "").strip().lower()
            if ts_user and ts_user != allowed_user:
                self._send_bytes(HTTPStatus.FORBIDDEN, "text/plain; charset=utf-8", b"Forbidden Tailscale user\n")
                return False
        return True

    def _check_post_csrf(self) -> bool:
        local_port = self.server.server_address[1]
        _, allowed_origins, _ = build_allowlists(local_port)

        ctype = (self.headers.get("Content-Type") or "").split(";", 1)[0].strip().lower()
        if ctype != "application/json":
            self._send_json(HTTPStatus.UNSUPPORTED_MEDIA_TYPE, {"error": "Content-Type must be application/json"})
            return False

        sec_fetch_site = (self.headers.get("Sec-Fetch-Site") or "").strip().lower()
        if sec_fetch_site and sec_fetch_site != "same-origin":
            self._send_json(HTTPStatus.FORBIDDEN, {"error": "Cross-origin POST rejected"})
            return False

        origin = (self.headers.get("Origin") or "").strip().lower().rstrip("/")
        if origin and origin not in allowed_origins:
            self._send_json(HTTPStatus.FORBIDDEN, {"error": "Disallowed Origin header"})
            return False

        return True

    def _read_json(self) -> dict | None:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            return None
        if length < 0 or length > 65536:
            return None
        raw = self.rfile.read(length) if length else b"{}"
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            return None
        return data if isinstance(data, dict) else None

    def do_GET(self) -> None:  # noqa: N802
        if not _CONCURRENCY_SEM.acquire(blocking=False):
            self._send_bytes(HTTPStatus.SERVICE_UNAVAILABLE, "text/plain; charset=utf-8", b"Server busy\n")
            return
        try:
            if not self._check_host_and_user():
                return

            parsed = urlparse(self.path)
            path = unquote(parsed.path)

            if path in ("/", "/index.html"):
                self._send_bytes(
                    HTTPStatus.OK,
                    "text/html; charset=utf-8",
                    INDEX_HTML.encode("utf-8"),
                    csp=INDEX_CSP,
                )
                return

            if path == "/health":
                self._send_json(HTTPStatus.OK, {"ok": True})
                return

            if path == "/api/briefs":
                self._send_json(
                    HTTPStatus.OK,
                    {
                        "active": list_scope("active"),
                        "archive": list_scope("archive"),
                    },
                )
                return

            if path.startswith("/archive/"):
                name = path[len("/archive/"):]
                target = resolve_brief(name, scope="archive")
            elif path.startswith("/"):
                name = path[1:]
                target = resolve_brief(name, scope="active")
            else:
                target = None

            if target is None:
                self._send_bytes(HTTPStatus.NOT_FOUND, "text/plain; charset=utf-8", b"Brief not found\n")
                return

            opened = open_regular_nofollow(target)
            if opened is None:
                self._send_bytes(HTTPStatus.NOT_FOUND, "text/plain; charset=utf-8", b"Brief not found\n")
                return

            fd, st = opened
            try:
                if st.st_size > MAX_BRIEF_BYTES:
                    os.close(fd)
                    self._send_bytes(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, "text/plain; charset=utf-8", b"Brief exceeds 10 MB limit\n")
                    return
                with os.fdopen(fd, "rb") as fh:
                    data = fh.read(MAX_BRIEF_BYTES + 1)
            except OSError:
                self._send_bytes(HTTPStatus.INTERNAL_SERVER_ERROR, "text/plain; charset=utf-8", b"Failed to read file\n")
                return

            if len(data) > MAX_BRIEF_BYTES:
                self._send_bytes(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, "text/plain; charset=utf-8", b"Brief exceeds 10 MB limit\n")
                return

            data = inject_brief_chrome(data, extract_title(target))
            self._send_bytes(HTTPStatus.OK, "text/html; charset=utf-8", data, csp=BRIEF_CSP)
        finally:
            _CONCURRENCY_SEM.release()

    def do_POST(self) -> None:  # noqa: N802
        if not _CONCURRENCY_SEM.acquire(blocking=False):
            self._send_json(HTTPStatus.SERVICE_UNAVAILABLE, {"error": "Server busy"})
            return
        try:
            if not self._check_host_and_user():
                return
            if not self._check_post_csrf():
                return

            parsed = urlparse(self.path)
            path = unquote(parsed.path)
            payload = self._read_json()
            if payload is None:
                self._send_json(HTTPStatus.BAD_REQUEST, {"error": "Invalid JSON body"})
                return

            ensure_dirs()

            if path == "/api/archive":
                name = str(payload.get("file", ""))
                src = resolve_brief(name, scope="active")
                dst = resolve_brief(name, scope="archive")
                if src is None or dst is None:
                    self._send_json(HTTPStatus.NOT_FOUND, {"error": "Active brief not found"})
                    return
                outcome = safe_move_no_overwrite(src, dst)
                if outcome == "not_found":
                    self._send_json(HTTPStatus.NOT_FOUND, {"error": "Active brief not found"})
                    return
                if outcome == "exists":
                    self._send_json(HTTPStatus.CONFLICT, {"error": "An archived brief with that name already exists"})
                    return
                self._send_json(HTTPStatus.OK, {"ok": True, "file": name})
                return

            if path == "/api/restore":
                name = str(payload.get("file", ""))
                src = resolve_brief(name, scope="archive")
                dst = resolve_brief(name, scope="active")
                if src is None or dst is None:
                    self._send_json(HTTPStatus.NOT_FOUND, {"error": "Archived brief not found"})
                    return
                outcome = safe_move_no_overwrite(src, dst)
                if outcome == "not_found":
                    self._send_json(HTTPStatus.NOT_FOUND, {"error": "Archived brief not found"})
                    return
                if outcome == "exists":
                    self._send_json(HTTPStatus.CONFLICT, {"error": "An active brief with that name already exists"})
                    return
                self._send_json(HTTPStatus.OK, {"ok": True, "file": name})
                return

            if path == "/api/delete":
                name = str(payload.get("file", ""))
                scope = "archive" if payload.get("scope") == "archive" else "active"
                target = resolve_brief(name, scope=scope)
                if target is None or target.is_symlink() or not target.exists():
                    self._send_json(HTTPStatus.NOT_FOUND, {"error": "Brief not found"})
                    return
                try:
                    st = target.lstat()
                    if not stat.S_ISREG(st.st_mode):
                        self._send_json(HTTPStatus.NOT_FOUND, {"error": "Brief not found"})
                        return
                    target.unlink()
                except FileNotFoundError:
                    self._send_json(HTTPStatus.NOT_FOUND, {"error": "Brief not found"})
                    return
                self._send_json(HTTPStatus.OK, {"ok": True, "file": name, "scope": scope})
                return

            if path == "/api/clear-archive":
                deleted = 0
                for entry in list(ARCHIVE_DIR.iterdir()):
                    if entry.is_symlink() or not is_safe_filename(entry.name):
                        continue
                    try:
                        if stat.S_ISREG(entry.lstat().st_mode):
                            entry.unlink()
                            deleted += 1
                    except OSError:
                        continue
                self._send_json(HTTPStatus.OK, {"ok": True, "deleted": deleted})
                return

            self._send_json(HTTPStatus.NOT_FOUND, {"error": "Unknown endpoint"})
        finally:
            _CONCURRENCY_SEM.release()


def main() -> None:
    parser = argparse.ArgumentParser(description="Serve HTML agent briefs over localhost/Tailscale.")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8766)
    args = parser.parse_args()

    ensure_dirs()
    server = BoundedThreadingHTTPServer((args.host, args.port), BriefsHandler)
    sys.stderr.write(f"[agent-briefs] Serving {BRIEFS_DIR} on http://{args.host}:{args.port}\n")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
