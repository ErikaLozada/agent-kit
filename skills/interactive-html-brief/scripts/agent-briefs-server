<script>
(() => {
  const themeBtn = document.getElementById("themeBtn");
  const mqDark = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  function effectiveTheme() {
    const explicit = document.documentElement.getAttribute("data-theme");
    if (explicit === "dark" || explicit === "light") return explicit;
    return mqDark && mqDark.matches ? "dark" : "light";
  }
  function syncThemeLabel() {
    themeBtn.textContent = effectiveTheme() === "dark" ? "Light" : "Dark";
  }
  function applyTheme(t, persist) {
    document.documentElement.setAttribute("data-theme", t);
    syncThemeLabel();
    if (persist) {
      try { localStorage.setItem("agent-briefs-theme", t); } catch (e) {}
    }
  }
  try {
    const saved = localStorage.getItem("agent-briefs-theme");
    if (saved === "dark" || saved === "light") applyTheme(saved, false);
    else syncThemeLabel();
  } catch (e) { syncThemeLabel(); }
  if (mqDark) {
    const onSysChange = () => {
      if (!document.documentElement.getAttribute("data-theme")) syncThemeLabel();
    };
    if (mqDark.addEventListener) mqDark.addEventListener("change", onSysChange);
    else if (mqDark.addListener) mqDark.addListener(onSysChange);
  }
  themeBtn.addEventListener("click", () => {
    applyTheme(effectiveTheme() === "dark" ? "light" : "dark", true);
  });

  const state = {
    tab: "active",
    query: "",
    active: [],
    archive: [],
    confirmKey: null,
    confirmTimer: null,
  };

  const els = {
    list: document.getElementById("briefList"),
    tabActive: document.getElementById("tabActive"),
    tabArchive: document.getElementById("tabArchive"),
    countActive: document.getElementById("countActive"),
    countArchive: document.getElementById("countArchive"),
    search: document.getElementById("searchInput"),
    refresh: document.getElementById("refreshBtn"),
    archiveBar: document.getElementById("archiveBar"),
    clearArchive: document.getElementById("clearArchiveBtn"),
    toast: document.getElementById("toast"),
  };

  let toastTimer = null;
  function showToast(msg) {
    els.toast.textContent = msg;
    els.toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => els.toast.classList.remove("show"), 2600);
  }

  function resetConfirm() {
    state.confirmKey = null;
    clearTimeout(state.confirmTimer);
    state.confirmTimer = null;
  }

  function armConfirm(key) {
    resetConfirm();
    state.confirmKey = key;
    state.confirmTimer = setTimeout(() => {
      state.confirmKey = null;
      render();
    }, 4000);
    render();
  }

  async function apiPost(endpoint, payload) {
    const res = await fetch(endpoint, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload || {}),
    });
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      throw new Error(data.error || ("HTTP " + res.status));
    }
    return res.json();
  }

  async function loadBriefs(quiet) {
    try {
      const res = await fetch("/api/briefs", { cache: "no-store" });
      if (!res.ok) throw new Error("HTTP " + res.status);
      const data = await res.json();
      state.active = data.active || [];
      state.archive = data.archive || [];
      render();
      if (!quiet) showToast("Refreshed");
    } catch (err) {
      showToast("Failed to load briefs: " + err.message);
    }
  }

  function esc(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function render() {
    els.countActive.textContent = String(state.active.length);
    els.countArchive.textContent = String(state.archive.length);

    els.tabActive.classList.toggle("active", state.tab === "active");
    els.tabArchive.classList.toggle("active", state.tab === "archive");
    els.tabActive.setAttribute("aria-selected", String(state.tab === "active"));
    els.tabArchive.setAttribute("aria-selected", String(state.tab === "archive"));

    const showArchiveBar = state.tab === "archive" && state.archive.length > 0;
    els.archiveBar.style.display = showArchiveBar ? "flex" : "none";
    const clearConfirming = state.confirmKey === "clear-archive";
    els.clearArchive.classList.toggle("confirming", clearConfirming);
    els.clearArchive.textContent = clearConfirming ? "Confirm Empty Archive?" : "Empty Archive";

    const items = state.tab === "active" ? state.active : state.archive;
    const q = state.query.trim().toLowerCase();
    const filtered = q
      ? items.filter((item) =>
          item.title.toLowerCase().includes(q) || item.file.toLowerCase().includes(q)
        )
      : items;

    if (filtered.length === 0) {
      els.list.innerHTML =
        '<div class="empty">' +
        (q
          ? "No briefs match your filter."
          : state.tab === "active"
            ? "No active briefs yet. Any agent can save HTML files to ~/agent-briefs/ or run publish-brief."
            : "Archive is empty.") +
        "</div>";
      return;
    }

    els.list.innerHTML = filtered
      .map((item) => {
        const delKey = "del:" + item.scope + ":" + item.file;
        const confirming = state.confirmKey === delKey;
        const primaryAction =
          item.scope === "active"
            ? '<button class="btn" type="button" data-action="archive" data-file="' + esc(item.file) + '">Archive</button>'
            : '<button class="btn" type="button" data-action="restore" data-file="' + esc(item.file) + '">Restore</button>';
        return (
          '<article class="card">' +
            '<a class="card-main" href="' + esc(item.url) + '">' +
              '<div class="card-title">' + esc(item.title) + "</div>" +
              '<div class="card-meta">' +
                '<span class="mono">' + esc(item.file) + "</span>" +
                "<span>" + esc(item.mtime_human) + "</span>" +
                "<span>" + esc(item.size_human) + "</span>" +
              "</div>" +
            "</a>" +
            '<div class="card-actions">' +
              '<a class="btn btn-primary" href="' + esc(item.url) + '">Open</a>' +
              primaryAction +
              '<button class="btn btn-danger' + (confirming ? " confirming" : "") + '" type="button" data-action="delete" data-scope="' + esc(item.scope) + '" data-file="' + esc(item.file) + '">' +
                (confirming ? "Confirm Delete?" : "Delete") +
              "</button>" +
            "</div>" +
          "</article>"
        );
      })
      .join("");
  }

  els.tabActive.addEventListener("click", () => {
    state.tab = "active";
    resetConfirm();
    render();
  });

  els.tabArchive.addEventListener("click", () => {
    state.tab = "archive";
    resetConfirm();
    render();
  });

  els.search.addEventListener("input", (e) => {
    state.query = e.target.value;
    render();
  });

  els.refresh.addEventListener("click", () => loadBriefs(false));

  els.clearArchive.addEventListener("click", async () => {
    if (state.confirmKey !== "clear-archive") {
      armConfirm("clear-archive");
      return;
    }
    resetConfirm();
    try {
      const res = await apiPost("/api/clear-archive", {});
      await loadBriefs(true);
      showToast("Cleared " + (res.deleted || 0) + " archived brief(s)");
    } catch (err) {
      showToast("Clear failed: " + err.message);
    }
  });

  els.list.addEventListener("click", async (e) => {
    const btn = e.target.closest("button[data-action]");
    if (!btn) return;
    const action = btn.dataset.action;
    const file = btn.dataset.file;
    const scope = btn.dataset.scope || state.tab;

    if (action === "archive") {
      resetConfirm();
      try {
        await apiPost("/api/archive", { file });
        await loadBriefs(true);
        showToast("Archived " + file);
      } catch (err) {
        showToast("Archive failed: " + err.message);
      }
      return;
    }

    if (action === "restore") {
      resetConfirm();
      try {
        await apiPost("/api/restore", { file });
        await loadBriefs(true);
        showToast("Restored " + file);
      } catch (err) {
        showToast("Restore failed: " + err.message);
      }
      return;
    }

    if (action === "delete") {
      const delKey = "del:" + scope + ":" + file;
      if (state.confirmKey !== delKey) {
        armConfirm(delKey);
        return;
      }
      resetConfirm();
      try {
        await apiPost("/api/delete", { file, scope });
        await loadBriefs(true);
        showToast("Deleted " + file);
      } catch (err) {
        showToast("Delete failed: " + err.message);
      }
    }
  });

  loadBriefs(true);
})();
</script>
</body>
</html>
"""


